{
  "name": "my-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:smoke": "pnpm build && playwright test --grep @smoke",
    "test:e2e:m1": "pnpm build && playwright test --grep @m1",
    "test:e2e:m2": "pnpm build && playwright test --grep @m2",
    "test:e2e:headed": "pnpm build && PW_HEADED=1 playwright test --grep @smoke",
    "qa:fast": "pnpm typecheck && vitest run --reporter=dot",
    "qa:smoke": "pnpm qa:fast && pnpm test:e2e:smoke",
    "qa:release": "pnpm typecheck && vitest run --reporter=dot && pnpm build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.22.0"
}
